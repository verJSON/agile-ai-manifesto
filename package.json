{
  "name": "agile-ai-manifesto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "test:e2e": "npm run build && playwright test",
    "consent:publish": "node scripts/publish-consent.mjs",
    "test:e2e:ci": "playwright install chromium && playwright test"
  },
  "dependencies": {
    "@verjson/consent": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "workerd@1.20261109.1": true,
    "esbuild@0.28.2": true
  }
}
